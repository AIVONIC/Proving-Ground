{
  "name": "crewai-northwind",
  "endpoint": "http://127.0.0.1:8391/chat",
  "method": "POST",
  "body_template": {
    "message": "{{message}}"
  },
  "history": {
    "mode": "server_session"
  },
  "session": {
    "capture_path": "session_id",
    "send_in": "body",
    "send_key": "session_id"
  },
  "response_text_path": "reply",
  "timeout_s": 180.0
}
