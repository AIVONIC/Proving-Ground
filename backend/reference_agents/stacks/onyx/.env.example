# Local, disposable. AUTH_TYPE=basic because Onyx 4.x no longer treats
# AUTH_TYPE=disabled as "everyone is an admin": admin routes 403 and
# /auth/register does not exist at all, so the build script could not run.
AUTH_TYPE=basic
IMAGE_TAG=v4.6.2
POSTGRES_PASSWORD=pg-ref-local
DISABLE_TELEMETRY=True
REQUIRE_EMAIL_VERIFICATION=False
SESSION_EXPIRE_TIME_SECONDS=86400
# Generate with: openssl rand -hex 32
USER_AUTH_SECRET=
